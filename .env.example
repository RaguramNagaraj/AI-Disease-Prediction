# ==============================================================================
# HealthAI Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Local Ollama AI Runtime
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=45.0

# Machine Learning Classifier Engine
ENABLE_ML_CLASSIFIER=true
ML_MODEL_PATH=backend/app/services/ml_engine/models/disease_classifier.joblib

# Emergency Dispatch Configuration
EMERGENCY_CONTACT_INDIA=112
EMERGENCY_CONTACT_INTERNATIONAL="911 / Local Emergency Dispatch"

# Application Environment
ENVIRONMENT=development
DEBUG=false
